    89 00000085 B442                        mov ah, 0x42
    90 00000087 CD13                        int 0x13
    91 00000089 720D                        jc fatal
    92                                  
    93                                      .handoff:
    94 0000008B 8D06[0E01]                  lea ax, [endmsg]
