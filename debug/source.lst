    96                                      ; jmp to the start of the stage 2 code,
    97                                      ; +16 bytes because of the single-byte length header,
    98                                      ; and then padding to ensure stage 2 starts at a 16-byte aligned address
    99 00000092 E9(1080)                    jmp 0x8010
