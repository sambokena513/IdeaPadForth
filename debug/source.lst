    69 00000061 7435                        jz fatal ; we don't deal with CHS since every BIOS since the 90s supports LBA, so we just fail here
    70                                  
    71 00000063 BE[B400]                    mov si, DAPS
    72 00000066 B442                        mov ah, 0x42 ; note that we don't set dl here since BIOS starts our code with DL = the drive being booted
    73 00000068 CD13                        int 0x13
    74 0000006A 722C                        jc fatal
    75                                  
    76 0000006C A00080                      mov al, [0x8000] ; first byte of stage 2 is its length in disk sectors
