    39 0000002B CD15                        int 0x15
    40 0000002D 7269                        jc fatal
    41 0000002F 84E4                        test ah, ah
    42 00000031 7565                        jnz fatal
    43                                  
    44 00000033 B80224                      mov ax, 0x2402
    45 00000036 CD15                        int 0x15
    46 00000038 725E                        jc fatal
    47 0000003A 84E4                        test ah, ah
    48 0000003C 755A                        jnz fatal
    49 0000003E 84C0                        test al, al
    50 00000040 750B                        jnz .a20_activated
    51                                  
    52 00000042 B80124                      mov ax, 0x2401
    53 00000045 CD15                        int 0x15
    54 00000047 724F                        jc fatal
    55 00000049 84E4                        test ah, ah
    56 0000004B 754B                        jnz fatal
    57                                  
    58                                      .a20_activated:
    59 0000004D 8D06[FA00]                  lea ax, [a20msg]
    60 00000051 E84D00                      call putstr
    61                                  
    62                                      ; check if EDD is supported
    63 00000054 B441                        mov ah, 0x41
    64 00000056 BBAA55                      mov bx, 0x55aa
    65 00000059 CD13                        int 0x13
    66 0000005B 723B                        jc fatal
    67                                  
