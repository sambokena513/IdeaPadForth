     1                                  bits 16 ; we always start in 16-bit real mode
     2                                  org 0x7c00 ; BIOS loads our code at this address
     3                                  
     4                                  start:
     5 00000000 EA[0500]0000                jmp 0:.skip ; make sure CS is correct
     6                                      .skip:
