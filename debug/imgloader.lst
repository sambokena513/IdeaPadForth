     1                                  ; forth image loader, this file's job is to
     2                                  ; set up everything needed to be able to boot
     3                                  ; the forth image starting at lba 128
     4                                  
     5                                  ; ABI note; we don't have a complex calling convention in the bootloader, especially in real mode, but once we switch to protected
     6                                  ; mode we treat the first four registers (eax, ebx, ecx, edx) as caller-saved, and the other four (esi, edi, ebp, esp) as callee-saved,
     7                                  ; and args as being in order in the first four registers. So a quaternary function is called with eax = arg1, ebx = arg2, ecx = arg3, and edx = arg4.
     8                                  
     9                                  bits 16
    10                                  org 0x8000 ; start just after boot sector
    11                                  
    12                                  %define e820_base_offset 0 ; qword
    13                                  %define e820_length_offset 8 ; qword
    14                                  %define e820_type_offset 16 ; dword
    15                                  
    16                                  ; essentially only type 1 is initially allocatable
    17                                  
    18                                  %define e820_USABLE 1 ; valid RAM
    19                                  %define e820_RESERVED 2 ; reserved by firmware or devices
    20                                  %define e820_ACPI 3 ; can reclaim after processing ACPI data
    21                                  %define e820_NVS 4 ; firmware expects this to be preserved across sleep/restore states
    22                                  %define e820_UNUSABLE 5 ; bad memory
    23                                  %define SMAP 0x534d4150
    24                                  
    25                                  ; very slightly increases binary size compared to db because it uses a jmp,
    26                                  ; but we have 32KB of code space here, so it's not really an issue for the convenience
    27                                  %macro lstr 2+
    28                                      jmp %%skip
    29                                      %%string:
    30                                      db %2,0
    31                                      %%skip:
    32                                      lea %1,%%string
    33                                  %endmacro
